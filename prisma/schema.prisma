// Central — schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  totpSecret   String?
  totpVerified Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  commitments  Commitment[]
  bills        Bill[]
  projects     Project[]
  finance      Finance?
  transactions Transaction[]
  envelopes    Envelope[]
  weeklyBudgets WeeklyBudget[]
  verses       Verse[]
  checkins     Checkin[]
  mediaItems   MediaItem[]
  debts        Debt[]
  balanceHistory BalanceHistory[]
  creditCards  CreditCard[]
}

model Commitment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  startAt   DateTime
  location  String?
  area      String?
  recurring String?  // daily | weekdays | weekly | monthly | null (one-off)
  done      Boolean   @default(false) // só faz sentido pra compromisso não-recorrente — um recorrente
                                       // é sempre projetado pra próxima ocorrência, nunca fica "atrasado"
  doneAt    DateTime?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  @@index([userId, startAt])
  @@index([userId, area])
  @@index([projectId])
}

model Bill {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  amount    Float
  dueDate   DateTime
  paid      Boolean    @default(false)
  paidAt    DateTime?
  priority  String     @default("normal") // critico | importante | normal | opcional
  recurring String?    // monthly | weekly | null (one-off)
  installments      Int?     // total parcelas — null means indeterminado (repete até cancelar, ex: streaming)
  installmentNumber Int?     // parcela atual (1-based), só relevante quando installments está definido
  area      String?
  createdAt DateTime   @default(now())
  envelopes Envelope[]
  projectId String?
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creditCardId String?
  creditCard   CreditCard? @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  creditCardPurchases CreditCardPurchase[]
  @@index([userId, dueDate])
  @@index([userId, area])
  @@index([projectId])
}

// A credit card with a monthly billing cycle: purchases accumulate until
// closingDay, then the whole cycle's total is materialized into one Bill due
// on dueDay — see lib/creditCard.ts. Deliberately no per-purchase Bill (that's
// what Bill.installments is for, on a normal non-card purchase).
model CreditCard {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  closingDay Int
  dueDay     Int
  limite     Float?
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  purchases  CreditCardPurchase[]
  bills      Bill[]
  @@index([userId])
}

// A single purchase on a card. `billId` is null while its cycle is still
// open; once the cycle closes it's stamped with the Bill created for that
// invoice and its amount is frozen (part of the invoice total from then on).
// `recurring`: when the cycle that bills this purchase closes, a fresh copy
// is created in the new cycle automatically (e.g. a Netflix subscription
// charged on the card) — see lib/creditCard.ts.
model CreditCardPurchase {
  id        String     @id @default(cuid())
  cardId    String
  card      CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  title     String
  amount    Float
  date      DateTime   @default(now())
  recurring Boolean    @default(false)
  billId    String?
  bill      Bill?      @relation(fields: [billId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  @@index([cardId, date])
  @@index([billId])
}

// Something that happened: money in or out.
model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // income | expense
  title     String
  amount    Float
  date      DateTime
  categoria String?  // moradia | alimentacao | transporte | saude | lazer | educacao | outros — expense only, optional
  createdAt DateTime @default(now())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  @@index([userId, date])
  @@index([userId, type])
  @@index([projectId])
}

// Money already set aside for a purpose (optionally toward a specific Bill).
model Envelope {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  allocated Float    @default(0)
  billId    String?
  bill      Bill?    @relation(fields: [billId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@index([projectId])
}

// A project has a beginning, a goal and an end — unlike a Commitment (fixed
// time) or a Bill (fixed due date). "Próxima ação" is computed as the first
// undone Task, in stage/task order — not stored, so it can't drift from reality.
model Project {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  area            String
  objetivo        String?
  statusNote      String?
  status          String   @default("planejado") // planejado | ativo | esperando | bloqueado | concluido
  esperandoMotivo String?
  prioridade      String   @default("media") // baixa | media | alta
  prazo           DateTime?
  orcamento       Float?
  metaContribuicao Float?  // quanto guardar por período (ex: 100 = "guarde R$100/semana")
  metaFrequencia   String? // semanal | mensal
  hasAlert        Boolean  @default(false)
  archived        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  stages          Stage[]
  tasks           Task[]
  notes           Note[]
  decisions       Decision[]
  commitments     Commitment[]
  bills           Bill[]
  transactions    Transaction[]
  envelopes       Envelope[]
  links           Link[]
  attachments     Attachment[]
  @@index([userId, area])
  @@index([userId, status])
}

// A file uploaded to Vercel Blob and attached to a Project — receipts,
// photos, PDFs. `pathname` is the blob's own key (needed to delete it from
// storage later); `url` is what the UI links to directly.
model Attachment {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName    String
  url         String
  pathname    String
  contentType String?
  size        Int?
  createdAt   DateTime @default(now())
  @@index([projectId])
}

// A named group of tasks inside a Project (e.g. "Reserva", "Preparação") —
// lets a project's checklist show structure instead of one long flat list.
model Stage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  tasks     Task[]
  @@index([projectId])
}

// A step inside a Project — Área → Projeto → Etapa → Tarefas, per the roadmap.
model Task {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageId   String?
  stage     Stage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  title     String
  done      Boolean   @default(false)
  doneAt    DateTime?
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  @@index([projectId])
  @@index([stageId])
}

// A freeform thought about a Project that isn't actionable — not a Task.
model Note {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  @@index([projectId])
}

// A recorded decision on a Project, so the "why" survives past the outcome.
model Decision {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  @@index([projectId])
}

// A reference link saved on a Project (a product page, a quote, an article)
// — just a URL, no file storage needed.
model Link {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  label     String?
  createdAt DateTime @default(now())
  @@index([projectId])
}

// A recurring weekly spending category without a fixed due date.
// kind "fixed" (carro, casa) always counts fully into "comprometido" —
// it's savings toward a real obligation. kind "ceiling" (mercado,
// combustível...) is a budget cap: only what's left unspent this week
// counts as committed, so under-spending doesn't get lost as "free".
model WeeklyBudget {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  amount         Float
  kind           String   @default("ceiling") // fixed | ceiling
  actualThisWeek Float    @default(0)
  weekOf         DateTime @default(now())
  createdAt      DateTime @default(now())
  @@index([userId])
}

// An informal debt to a person — no due date, no fixed parcela, paid down
// irregularly (whatever amount, whenever possible), sometimes in cash and
// sometimes in permuta (trade). Deliberately outside the Bill/committed
// system: it never counts as "comprometido" and never shows as a negative
// saldo or an alert — just a quiet running balance the user checks by choice.
model Debt {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  pessoa     String
  nota       String?
  saldo      Float
  archived   Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  pagamentos DebtPayment[]
  @@index([userId])
}

// One partial settlement against a Debt — dinheiro reduces the saldo
// bancário too (real money left), permuta only reduces what's owed.
model DebtPayment {
  id     String   @id @default(cuid())
  debtId String
  debt   Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  valor  Float
  metodo String // dinheiro | permuta
  nota   String?
  date   DateTime @default(now())
  @@index([debtId])
}

// Personal reading/watching list — livro or filme_serie, tracked through
// three real states (a plain done/not-done checklist can't tell "lendo"
// from "próximo"), unlike the generic Project/Task checklist elsewhere.
model MediaItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // livro | filme_serie
  title     String
  status    String   @default("proximo") // proximo | andamento | concluido
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, kind, status])
}

// A verse from the memorization list — one is shown per day, picked
// deterministically so it stays the same all day and rotates daily.
model Verse {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference String
  text      String?
  order     Int
  createdAt DateTime @default(now())
  @@index([userId, order])
}

// Daily "how are you feeling" check-in — one per user per day.
model Checkin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime // truncated to midnight, one row per day
  mood      String
  note      String?
  createdAt DateTime @default(now())
  @@unique([userId, date])
}

// Saldo atual (bancário) — não é o mesmo que dinheiro livre.
// Livre = currentBalance - soma dos Envelope.allocated.
model Finance {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentBalance   Float    @default(0)
  weeklyBaseIncome Float    @default(1500)
  // Dízimo is money already owed, not money set aside — no envelope, just a
  // running total that grows 10% with every income and zeroes out the
  // moment it's actually sent to the church.
  dizimoPendente   Float    @default(0)
  dizimoPagoEm     DateTime?
  updatedAt        DateTime @updatedAt
}

// A log of currentBalance after every change that touches it (income/expense
// transactions, bills marked paid/unpaid, debt payments in cash) — the only
// way to chart balance over time, since currentBalance itself only ever
// holds the latest value.
model BalanceHistory {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance Float
  date    DateTime @default(now())
  @@index([userId, date])
}
