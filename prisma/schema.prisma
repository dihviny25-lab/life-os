// Central — schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  totpSecret   String?
  totpVerified Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  commitments  Commitment[]
  bills        Bill[]
  projects     Project[]
  finance      Finance?
  transactions Transaction[]
  envelopes    Envelope[]
  weeklyBudgets WeeklyBudget[]
}

model Commitment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  startAt   DateTime
  location  String?
  area      String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([userId, startAt])
  @@index([userId, area])
}

model Bill {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  amount    Float
  dueDate   DateTime
  paid      Boolean    @default(false)
  priority  String     @default("normal") // critico | importante | normal | opcional
  recurring String?    // monthly | weekly | null (one-off)
  area      String?
  createdAt DateTime   @default(now())
  envelopes Envelope[]
  @@index([userId, dueDate])
  @@index([userId, area])
}

// Something that happened: money in or out.
model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // income | expense
  title     String
  amount    Float
  date      DateTime
  createdAt DateTime @default(now())
  @@index([userId, date])
  @@index([userId, type])
}

// Money already set aside for a purpose (optionally toward a specific Bill).
model Envelope {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  allocated Float    @default(0)
  billId    String?
  bill      Bill?    @relation(fields: [billId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

model Project {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  area       String
  statusNote String?
  status     String   @default("em_andamento") // ideia | em_andamento | aguardando_decisao | concluido
  hasAlert   Boolean  @default(false)
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tasks      Task[]
  @@index([userId, area])
  @@index([userId, status])
}

// A step inside a Project — Área → Projeto → Tarefas, per the roadmap.
model Task {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([projectId])
}

// A recurring weekly spending category without a fixed due date
// (mercado, combustível...) — money that already has a destination,
// even before it's spent. Counted into "comprometido" alongside envelopes.
model WeeklyBudget {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  amount    Float
  createdAt DateTime @default(now())
  @@index([userId])
}

// Saldo atual (bancário) — não é o mesmo que dinheiro livre.
// Livre = currentBalance - soma dos Envelope.allocated.
model Finance {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentBalance Float    @default(0)
  updatedAt      DateTime @updatedAt
}
