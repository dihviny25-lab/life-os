// Central — schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  totpSecret   String?
  totpVerified Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  commitments  Commitment[]
  bills        Bill[]
  projects     Project[]
  finance      Finance?
  transactions Transaction[]
  envelopes    Envelope[]
  weeklyBudgets WeeklyBudget[]
  verses       Verse[]
  checkins     Checkin[]
  mediaItems   MediaItem[]
}

model Commitment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  startAt   DateTime
  location  String?
  area      String?
  recurring String?  // daily | weekdays | weekly | monthly | null (one-off)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  @@index([userId, startAt])
  @@index([userId, area])
  @@index([projectId])
}

model Bill {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  amount    Float
  dueDate   DateTime
  paid      Boolean    @default(false)
  priority  String     @default("normal") // critico | importante | normal | opcional
  recurring String?    // monthly | weekly | null (one-off)
  installments      Int?     // total parcelas — null means indeterminado (repete até cancelar, ex: streaming)
  installmentNumber Int?     // parcela atual (1-based), só relevante quando installments está definido
  area      String?
  createdAt DateTime   @default(now())
  envelopes Envelope[]
  projectId String?
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  @@index([userId, dueDate])
  @@index([userId, area])
  @@index([projectId])
}

// Something that happened: money in or out.
model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // income | expense
  title     String
  amount    Float
  date      DateTime
  createdAt DateTime @default(now())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  @@index([userId, date])
  @@index([userId, type])
  @@index([projectId])
}

// Money already set aside for a purpose (optionally toward a specific Bill).
model Envelope {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  allocated Float    @default(0)
  billId    String?
  bill      Bill?    @relation(fields: [billId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

// A project has a beginning, a goal and an end — unlike a Commitment (fixed
// time) or a Bill (fixed due date). "Próxima ação" is computed as the first
// undone Task, in stage/task order — not stored, so it can't drift from reality.
model Project {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  area            String
  objetivo        String?
  statusNote      String?
  status          String   @default("planejado") // planejado | ativo | esperando | bloqueado | concluido
  esperandoMotivo String?
  prioridade      String   @default("media") // baixa | media | alta
  prazo           DateTime?
  orcamento       Float?
  hasAlert        Boolean  @default(false)
  archived        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  stages          Stage[]
  tasks           Task[]
  notes           Note[]
  decisions       Decision[]
  commitments     Commitment[]
  bills           Bill[]
  transactions    Transaction[]
  @@index([userId, area])
  @@index([userId, status])
}

// A named group of tasks inside a Project (e.g. "Reserva", "Preparação") —
// lets a project's checklist show structure instead of one long flat list.
model Stage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  tasks     Task[]
  @@index([projectId])
}

// A step inside a Project — Área → Projeto → Etapa → Tarefas, per the roadmap.
model Task {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageId   String?
  stage     Stage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  title     String
  done      Boolean   @default(false)
  doneAt    DateTime?
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  @@index([projectId])
  @@index([stageId])
}

// A freeform thought about a Project that isn't actionable — not a Task.
model Note {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  @@index([projectId])
}

// A recorded decision on a Project, so the "why" survives past the outcome.
model Decision {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  @@index([projectId])
}

// A recurring weekly spending category without a fixed due date.
// kind "fixed" (carro, casa) always counts fully into "comprometido" —
// it's savings toward a real obligation. kind "ceiling" (mercado,
// combustível...) is a budget cap: only what's left unspent this week
// counts as committed, so under-spending doesn't get lost as "free".
model WeeklyBudget {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  amount         Float
  kind           String   @default("ceiling") // fixed | ceiling
  actualThisWeek Float    @default(0)
  weekOf         DateTime @default(now())
  createdAt      DateTime @default(now())
  @@index([userId])
}

// Personal reading/watching list — livro or filme_serie, tracked through
// three real states (a plain done/not-done checklist can't tell "lendo"
// from "próximo"), unlike the generic Project/Task checklist elsewhere.
model MediaItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // livro | filme_serie
  title     String
  status    String   @default("proximo") // proximo | andamento | concluido
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, kind, status])
}

// A verse from the memorization list — one is shown per day, picked
// deterministically so it stays the same all day and rotates daily.
model Verse {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference String
  text      String?
  order     Int
  createdAt DateTime @default(now())
  @@index([userId, order])
}

// Daily "how are you feeling" check-in — one per user per day.
model Checkin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime // truncated to midnight, one row per day
  mood      String
  note      String?
  createdAt DateTime @default(now())
  @@unique([userId, date])
}

// Saldo atual (bancário) — não é o mesmo que dinheiro livre.
// Livre = currentBalance - soma dos Envelope.allocated.
model Finance {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentBalance   Float    @default(0)
  weeklyBaseIncome Float    @default(1500)
  updatedAt        DateTime @updatedAt
}
